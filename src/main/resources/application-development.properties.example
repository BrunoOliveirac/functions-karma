# JWT — use a long random string in real environments (never commit the real file)
jwt.secret=change-me-to-a-long-random-secret-key

# DATABASE — adjust host, port, database name, user and password to your local PostgreSQL
spring.datasource.url=jdbc:postgresql://localhost:5432/karma_homol?reWriteBatchedInserts=true
spring.datasource.username=postgres
spring.datasource.password=your-password-here

# JPA
spring.jpa.show-sql=true
spring.jpa.hibernate.ddl-auto=update

# FLYWAY — runs SQL migrations on startup
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# Use only when the database already exists (e.g. created via Hibernate)
# and Flyway has never run. Remove these lines on a fresh database setup.
# spring.flyway.baseline-on-migrate=true
# spring.flyway.baseline-version=202607070000
# RATE LIMIT
karma.rate-limit.login-per-minute=10
karma.rate-limit.register-per-hour=5
karma.rate-limit.authenticated-per-minute=120
karma.rate-limit.anonymous-per-minute=300
karma.rate-limit.trusted-proxies=project-name,IP,::1